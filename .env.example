PORT=3001

# Where finished videos, posters, and subtitles live. Defaults to ./videos
# next to server.js. Point at iCloud Drive (or another sync target) to keep
# your library off the local disk:
#   LIBRARY_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Vault/Library
# Note: disable "Optimize Mac Storage" in iCloud settings so files aren't
# evicted to placeholders — a dehydrated file can't be streamed.
# LIBRARY_DIR=

# Where torrents download to while still in-progress. Defaults to
# ./torrent-cache. KEEP THIS LOCAL — pointing it at iCloud means every
# downloaded piece triggers an upload, which trashes upstream bandwidth
# and can get you rate-limited.
# TORRENT_DIR=

# Where lazily-built HLS artifacts (fMP4 remux + playlists) are cached. These
# back reliable subtitles over AirPlay in Safari. Defaults to ./hls-cache.
# KEEP THIS LOCAL — same iCloud-churn reasoning as TORRENT_DIR.
# HLS_CACHE_DIR=

# Optional — enables movie-poster lookup from TMDB (themoviedb.org).
# Grab a free key at https://www.themoviedb.org/settings/api and paste below.
TMDB_API_KEY=
